#!/bin/bash

APP_BINARY="${TRIM_APPDEST}/server/vaultwarden"
ENV_FILE="${TRIM_PKGETC}/vaultwarden.env"
PID_FILE="${TRIM_PKGVAR}/vaultwarden.pid"
LOG_FILE="${TRIM_PKGVAR}/vaultwarden.log"
UPDATE_CHECKER="${TRIM_APPDEST}/server/check-update"
UPDATE_PID_FILE="${TRIM_PKGVAR}/update-checker.pid"

report_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}"
  fi
}

read_pid() {
  [ -r "${PID_FILE}" ] || return 1
  pid="$(head -n 1 "${PID_FILE}" | tr -cd '0-9')"
  [ -n "${pid}" ] || return 1
}

is_running() {
  read_pid || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  [ -r "/proc/${pid}/cmdline" ] || return 0
  tr '\0' ' ' < "/proc/${pid}/cmdline" | grep -Fq "${APP_BINARY}"
}

load_environment() {
  if [ -r "${ENV_FILE}" ]; then
    set -a
    # 此文件只由安装/配置回调使用安全转义生成。
    . "${ENV_FILE}"
    set +a
  fi
  # Vaultwarden 会拒绝“已定义但为空”的 DOMAIN；空值应等同于未配置。
  if [ -z "${DOMAIN:-}" ]; then
    unset DOMAIN
  fi
  export DATA_FOLDER="${TRIM_PKGVAR}/data"
  export WEB_VAULT_FOLDER="${TRIM_APPDEST}/server/web-vault"
  export ROCKET_ADDRESS="0.0.0.0"
  export ROCKET_PORT="${PORT:-${TRIM_SERVICE_PORT:-8222}}"
  export TMP_FOLDER="${TRIM_PKGVAR}/tmp"
  export HOME="${TRIM_PKGHOME:-${TRIM_PKGVAR}/home}"
  export SSL_CERT_FILE="${TRIM_APPDEST}/server/runtime/etc/ssl/certs/ca-certificates.crt"
}

start_update_checker() {
  [ "${AUTO_CHECK_UPDATES:-true}" = "true" ] || return 0
  [ -x "${UPDATE_CHECKER}" ] || return 0
  [ -s "${TRIM_APPDEST}/server/UPDATE_REPOSITORY" ] || return 0
  if [ -r "${UPDATE_PID_FILE}" ]; then
    update_pid="$(head -n 1 "${UPDATE_PID_FILE}" | tr -cd '0-9')"
    if [ -n "${update_pid}" ] && kill -0 "${update_pid}" 2>/dev/null; then
      return 0
    fi
  fi
  TRIM_APPDEST="${TRIM_APPDEST}" TRIM_PKGVAR="${TRIM_PKGVAR}" \
    UPDATE_CHECK_INTERVAL="${UPDATE_CHECK_INTERVAL:-86400}" \
    UPDATE_MANIFEST_URL="${UPDATE_MANIFEST_URL:-}" \
    "${UPDATE_CHECKER}" loop >> "${LOG_FILE}" 2>&1 &
  update_pid=$!
  printf '%s\n' "${update_pid}" > "${UPDATE_PID_FILE}"
}

stop_update_checker() {
  if [ -r "${UPDATE_PID_FILE}" ]; then
    update_pid="$(head -n 1 "${UPDATE_PID_FILE}" | tr -cd '0-9')"
    if [ -n "${update_pid}" ] && kill -0 "${update_pid}" 2>/dev/null; then
      kill -TERM "${update_pid}" 2>/dev/null || true
    fi
  fi
  rm -f "${UPDATE_PID_FILE}"
}

start_app() {
  if is_running; then
    return 0
  fi
  rm -f "${PID_FILE}"
  if [ ! -x "${APP_BINARY}" ]; then
    report_error "Vaultwarden 原生程序缺失，请重新安装应用。"
    return 1
  fi
  load_environment
  mkdir -p "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/tmp" "${HOME}"
  chmod 0700 "${TRIM_PKGVAR}/data"
  umask 077
  cd "${TRIM_APPDEST}/server" || return 1
  "${APP_BINARY}" >> "${LOG_FILE}" 2>&1 &
  pid=$!
  printf '%s\n' "${pid}" > "${PID_FILE}"
  sleep 2
  if ! is_running; then
    rm -f "${PID_FILE}"
    report_error "Vaultwarden 启动失败，请检查 ${LOG_FILE}。"
    return 1
  fi
  start_update_checker
}

stop_app() {
  stop_update_checker
  if ! is_running; then
    rm -f "${PID_FILE}"
    return 0
  fi
  kill -TERM "${pid}" 2>/dev/null || true
  count=0
  while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 20 ]; do
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "${pid}" 2>/dev/null; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi
  rm -f "${PID_FILE}"
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  *) exit 1 ;;
esac
