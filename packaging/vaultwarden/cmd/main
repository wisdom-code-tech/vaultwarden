#!/bin/bash

APP_BINARY="${TRIM_APPDEST}/server/vaultwarden"
GATEWAY_BINARY="${TRIM_APPDEST}/server/gateway-proxy"
GATEWAY_SOCKET="${TRIM_APPDEST}/vaultwarden.sock"
GATEWAY_PREFIX="/app/vaultwarden"
GATEWAY_DOMAIN_CACHE="${TRIM_PKGVAR}/gateway-domain"
ENV_FILE="${TRIM_PKGETC}/vaultwarden.env"
GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway-proxy.pid"
LOG_FILE="${TRIM_PKGVAR}/vaultwarden.log"

report_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}"
  fi
}

is_running() {
  [ -r "${GATEWAY_PID_FILE}" ] || return 1
  gateway_pid="$(head -n 1 "${GATEWAY_PID_FILE}" | tr -cd '0-9')"
  [ -n "${gateway_pid}" ] || return 1
  kill -0 "${gateway_pid}" 2>/dev/null || return 1
  [ -r "/proc/${gateway_pid}/cmdline" ] || return 0
  tr '\0' ' ' < "/proc/${gateway_pid}/cmdline" | grep -Fq "${GATEWAY_BINARY}"
}

vaultwarden_pids() {
  app_binary_real="$(readlink -f "${APP_BINARY}" 2>/dev/null || printf '%s' "${APP_BINARY}")"
  for proc_exe in /proc/[0-9]*/exe; do
    process_binary="$(readlink "${proc_exe}" 2>/dev/null || true)"
    process_binary="${process_binary% (deleted)}"
    [ "${process_binary}" = "${app_binary_real}" ] || continue
    proc_dir="${proc_exe%/exe}"
    printf '%s\n' "${proc_dir##*/}"
  done
}

stop_orphaned_vaultwarden() {
  vaultwarden_processes="$(vaultwarden_pids)"
  [ -n "${vaultwarden_processes}" ] || return 0
  for vaultwarden_pid in ${vaultwarden_processes}; do
    kill -TERM "${vaultwarden_pid}" 2>/dev/null || true
  done
  count=0
  while [ "${count}" -lt 10 ]; do
    vaultwarden_processes="$(vaultwarden_pids)"
    [ -z "${vaultwarden_processes}" ] && return 0
    sleep 1
    count=$((count + 1))
  done
  for vaultwarden_pid in ${vaultwarden_processes}; do
    kill -KILL "${vaultwarden_pid}" 2>/dev/null || true
  done
}

load_environment() {
  if [ -r "${ENV_FILE}" ]; then
    set -a
    # 此文件只由安装/配置回调使用安全转义生成。
    . "${ENV_FILE}"
    set +a
  fi
  # DOMAIN 由统一网关代理从真实请求自动生成，旧配置不得覆盖。
  unset DOMAIN
  export DATA_FOLDER="${TRIM_PKGVAR}/data"
  export WEB_VAULT_FOLDER="${TRIM_APPDEST}/server/web-vault"
  export ROCKET_ADDRESS="127.0.0.1"
  export ROCKET_PORT="${PORT:-${TRIM_SERVICE_PORT:-8222}}"
  export TMP_FOLDER="${TRIM_PKGVAR}/tmp"
  export HOME="${TRIM_PKGHOME:-${TRIM_PKGVAR}/home}"
  export SSL_CERT_FILE="${TRIM_APPDEST}/server/runtime/etc/ssl/certs/ca-certificates.crt"
}

start_app() {
  if is_running; then
    return 0
  fi
  if [ ! -x "${APP_BINARY}" ] || [ ! -x "${GATEWAY_BINARY}" ]; then
    report_error "Vaultwarden 或统一网关代理缺失，请重新安装应用。"
    return 1
  fi
  if [ -e "${GATEWAY_SOCKET}" ] && [ ! -S "${GATEWAY_SOCKET}" ]; then
    report_error "统一网关 Socket 路径被非 Socket 文件占用：${GATEWAY_SOCKET}"
    return 1
  fi

  # rc6 及更早版本可能在代理退出后遗留 Vaultwarden 子进程。
  stop_orphaned_vaultwarden

  load_environment
  mkdir -p "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/tmp" "${HOME}"
  chmod 0700 "${TRIM_PKGVAR}/data"
  umask 077
  rm -f "${GATEWAY_PID_FILE}"
  "${GATEWAY_BINARY}" \
    -socket "${GATEWAY_SOCKET}" \
    -upstream "http://127.0.0.1:${ROCKET_PORT}" \
    -prefix "${GATEWAY_PREFIX}" \
    -vaultwarden "${APP_BINARY}" \
    -domain-cache "${GATEWAY_DOMAIN_CACHE}" >> "${LOG_FILE}" 2>&1 &
  gateway_pid=$!
  printf '%s\n' "${gateway_pid}" > "${GATEWAY_PID_FILE}"
  sleep 1
  if ! is_running || [ ! -S "${GATEWAY_SOCKET}" ]; then
    rm -f "${GATEWAY_PID_FILE}"
    report_error "统一网关代理启动失败，请检查 ${LOG_FILE}。"
    return 1
  fi
}

stop_app() {
  if is_running; then
    kill -TERM "${gateway_pid}" 2>/dev/null || true
    count=0
    while kill -0 "${gateway_pid}" 2>/dev/null && [ "${count}" -lt 30 ]; do
      sleep 1
      count=$((count + 1))
    done
    if kill -0 "${gateway_pid}" 2>/dev/null; then
      kill -KILL "${gateway_pid}" 2>/dev/null || true
    fi
  fi
  stop_orphaned_vaultwarden
  rm -f "${GATEWAY_PID_FILE}"
  if [ -S "${GATEWAY_SOCKET}" ]; then
    rm -f "${GATEWAY_SOCKET}"
  fi
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  cleanup) stop_orphaned_vaultwarden ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  *) exit 1 ;;
esac
