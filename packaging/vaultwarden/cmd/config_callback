#!/bin/bash

ENV_FILE="${TRIM_PKGETC}/vaultwarden.env"

write_setting() {
  key="$1"
  value="$2"
  escaped="$(printf '%s' "${value}" | sed "s/'/'\\\\''/g")"
  printf "%s='%s'\n" "${key}" "${escaped}"
}

mkdir -p "${TRIM_PKGETC}"
temp_file="${ENV_FILE}.tmp.$$"
{
  write_setting PORT "${wizard_port:-8222}"
  write_setting ADMIN_TOKEN "${wizard_admin_token:-}"
  write_setting SIGNUPS_ALLOWED "${wizard_signups_allowed:-false}"
  write_setting ENABLE_WEBSOCKET "true"
  write_setting AUTO_CHECK_UPDATES "${wizard_auto_check_updates:-true}"
} > "${temp_file}"
chmod 0600 "${temp_file}"
mv "${temp_file}" "${ENV_FILE}"

bash "${0%/*}/main" stop
bash "${0%/*}/main" start
