#!/bin/bash
set -eE

. "${0%/*}/common"
trap 'report_error "安装初始化失败，请查看应用中心日志。"' ERR
if [ "$(id -u)" -eq 0 ]; then
  prepare_package_directories
  bash "${TRIM_APPDEST}/server/install-updater.sh"
  run_as_package --package-callback
fi
if [ "${1:-}" != "--package-callback" ]; then
  report_error "安装回调未以 root 完成升级助手部署。"
  exit 1
fi

ENV_FILE="${TRIM_PKGETC}/vaultwarden.env"

write_setting() {
  key="$1"
  value="$2"
  escaped="$(printf '%s' "${value}" | sed "s/'/'\\\\''/g")"
  printf "%s='%s'\n" "${key}" "${escaped}"
}

mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/tmp"
chmod 0700 "${TRIM_PKGVAR}/data"

if [ -f "${ENV_FILE}" ] && [ "${wizard_existing_config_action:-overwrite}" = "keep" ]; then
  exit 0
fi

temp_file="${ENV_FILE}.tmp.$$"
if [ -f "${ENV_FILE}" ]; then
  # 应用本次安装设置，同时保留 SMTP 等不由安装向导管理的高级配置。
  sed '/^PORT=/d; /^SIGNUPS_ALLOWED=/d; /^ENABLE_WEBSOCKET=/d; /^DOMAIN=/d; /^ADMIN_TOKEN=/d; /^DISABLE_ADMIN_TOKEN=/d; /^AUTO_CHECK_UPDATES=/d' "${ENV_FILE}" > "${temp_file}"
else
  : > "${temp_file}"
fi
{
  write_setting PORT "${wizard_port:-8222}"
  write_setting SIGNUPS_ALLOWED "${wizard_signups_allowed:-false}"
  write_setting ENABLE_WEBSOCKET "${wizard_enable_websocket:-true}"
} >> "${temp_file}"
chmod 0600 "${temp_file}"
mv "${temp_file}" "${ENV_FILE}"
exit 0
