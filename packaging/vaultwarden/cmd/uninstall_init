#!/bin/bash
set -eE

. "${0%/*}/common"
trap 'report_error "卸载升级助手失败，请查看应用中心日志。"' ERR

if [ -f /etc/systemd/system/vaultwarden-updater.service ]; then
  systemctl disable --now vaultwarden-updater.service
  rm -f /etc/systemd/system/vaultwarden-updater.service
  systemctl daemon-reload
fi
rm -f /usr/local/libexec/vaultwarden-updater
rm -rf /var/lib/vaultwarden-updater
exit 0

