[
  {
    "stepTitle": "Vaultwarden 设置",
    "items": [
      {
        "type": "text",
        "field": "wizard_domain",
        "label": "统一网关完整地址",
        "rules": [
          {"required": true, "message": "请输入统一网关完整地址"},
          {"pattern": "^https://.+/app/vaultwarden/?$", "message": "格式必须为 https://主机/app/vaultwarden"}
        ]
      },
      {
        "type": "password",
        "field": "wizard_admin_token",
        "label": "管理后台令牌",
        "rules": [
          {"required": true, "message": "请输入管理后台令牌"},
          {"min": 12, "message": "令牌至少 12 个字符"}
        ]
      },
      {
        "type": "radio",
        "field": "wizard_signups_allowed",
        "label": "允许新用户注册",
        "initValue": "false",
        "options": [
          {"label": "关闭（推荐）", "value": "false"},
          {"label": "开启", "value": "true"}
        ]
      },
      {
        "type": "switch",
        "field": "wizard_auto_check_updates",
        "label": "每天自动检查 FPK 更新",
        "initValue": "true"
      }
    ]
  }
]
